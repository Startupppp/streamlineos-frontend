{
  "manifest_version": 3,
  "name": "StreamlineOS Sourcer",
  "version": "0.1.0",
  "description": "Save a profile you are looking at into StreamlineOS Recruitment, with the candidate's data recorded under a stated consent.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_title": "Save to StreamlineOS",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
