{
  "openapi": "3.0.3",
  "info": { "title": "StreamlineOS API — timesheets fixture", "version": "0.0.0" },
  "paths": {
    "/timesheets/entries": {
      "get": { "operationId": "EntriesController_list" },
      "post": {
        "operationId": "EntriesController_create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["date", "hours"],
                "properties": {
                  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "hours": { "type": "number", "exclusiveMinimum": 0 },
                  "projectId": { "type": "integer", "minimum": 1 },
                  "ticketId": { "type": "integer", "minimum": 1 },
                  "description": { "type": "string", "maxLength": 2000 },
                  "isBillable": { "type": "boolean" },
                  "billingType": { "type": "string", "enum": ["BILLABLE", "NON_BILLABLE", "FIXED"] },
                  "workLink": { "type": "string", "format": "uri", "maxLength": 500 },
                  "source": { "type": "string", "enum": ["MANUAL", "TIMER", "API", "IMPORT"] }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/entries/{entryId}": {
      "patch": {
        "operationId": "EntriesController_update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hours": { "type": "number", "exclusiveMinimum": 0 },
                  "description": { "type": "string", "maxLength": 2000, "nullable": true },
                  "isBillable": { "type": "boolean" },
                  "billingType": { "type": "string", "enum": ["BILLABLE", "NON_BILLABLE", "FIXED"] },
                  "projectId": { "type": "integer", "nullable": true },
                  "workLink": { "type": "string", "format": "uri", "nullable": true }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/entries/{entryId}/void": {
      "post": {
        "operationId": "EntriesController_void",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/approvals": {
      "get": { "operationId": "ApprovalsController_list" }
    },
    "/timesheets/approvals/bulk-approve": {
      "post": {
        "operationId": "ApprovalsController_bulkApprove",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["periodIds"],
                "properties": {
                  "periodIds": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "minItems": 1,
                    "maxItems": 100
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/approvals/bulk-reject": {
      "post": {
        "operationId": "ApprovalsController_bulkReject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["periodIds", "reason"],
                "properties": {
                  "periodIds": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/approvals/{periodId}/approve": {
      "post": { "operationId": "ApprovalsController_approve" }
    },
    "/timesheets/approvals/{periodId}/reject": {
      "post": {
        "operationId": "ApprovalsController_reject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/settings": {
      "get": { "operationId": "SettingsController_get" },
      "patch": {
        "operationId": "SettingsController_update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workWeekStart": { "type": "integer", "minimum": 0, "maximum": 6 },
                  "requiredFields": { "type": "array", "items": { "type": "string" } },
                  "roundingRule": {
                    "type": "string",
                    "enum": ["NONE", "NEAREST_5", "NEAREST_6", "NEAREST_10", "NEAREST_15", "ROUND_UP", "ROUND_DOWN"]
                  },
                  "maxHoursPerDay": { "type": "number", "maximum": 24 },
                  "allowOverlappingEntries": { "type": "boolean" },
                  "allowBackdatedEntries": { "type": "boolean" },
                  "backdateLimitDays": { "type": "integer", "nullable": true },
                  "approvalMode": { "type": "string", "enum": ["MANAGER", "AUTO", "MULTI_LEVEL"] },
                  "clientApprovalEnabled": { "type": "boolean" },
                  "lockAfterApproval": { "type": "boolean" },
                  "lockAfterInvoice": { "type": "boolean" },
                  "reminderRules": {},
                  "allowFutureEntries": { "type": "boolean" },
                  "expectedDailyHours": { "type": "number", "nullable": true },
                  "expectedWeeklyHours": { "type": "number", "nullable": true },
                  "submissionGraceDays": { "type": "integer", "nullable": true },
                  "changeReason": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/timer/active": {
      "get": { "operationId": "TimerController_getActive" }
    },
    "/timesheets/timer/start": {
      "post": {
        "operationId": "TimerController_start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": { "type": "integer", "minimum": 1 },
                  "ticketId": { "type": "integer", "minimum": 1 },
                  "description": { "type": "string", "maxLength": 500 },
                  "billable": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/timer/{timerId}/pause": {
      "post": { "operationId": "TimerController_pause" }
    },
    "/timesheets/timer/{timerId}/resume": {
      "post": { "operationId": "TimerController_resume" }
    },
    "/timesheets/timer/{timerId}/discard": {
      "post": { "operationId": "TimerController_discard" }
    },
    "/timesheets/timer/{timerId}/convert": {
      "post": {
        "operationId": "TimerController_convert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "hours": { "type": "number", "exclusiveMinimum": 0 },
                  "isBillable": { "type": "boolean" },
                  "description": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/rates": {
      "get": { "operationId": "RatesController_list" },
      "post": {
        "operationId": "RatesController_create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["billRate"],
                "properties": {
                  "projectId": { "type": "integer", "minimum": 1 },
                  "userId": { "type": "string" },
                  "taskId": { "type": "integer", "minimum": 1 },
                  "clientId": { "type": "integer", "minimum": 1 },
                  "billingType": { "type": "string", "enum": ["BILLABLE", "NON_BILLABLE", "FIXED"] },
                  "billRate": { "type": "number", "exclusiveMinimum": 0 },
                  "costRate": { "type": "number", "exclusiveMinimum": 0 },
                  "currency": { "type": "string", "maxLength": 3 },
                  "priority": { "type": "integer", "minimum": 0 },
                  "rateCardId": { "type": "integer", "minimum": 1 },
                  "effectiveFrom": { "type": "string", "nullable": true },
                  "effectiveTo": { "type": "string", "nullable": true }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/rates/{rateId}": {
      "patch": {
        "operationId": "RatesController_update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": { "type": "integer", "minimum": 1 },
                  "userId": { "type": "string" },
                  "taskId": { "type": "integer", "minimum": 1 },
                  "clientId": { "type": "integer", "minimum": 1 },
                  "billingType": { "type": "string", "enum": ["BILLABLE", "NON_BILLABLE", "FIXED"] },
                  "billRate": { "type": "number", "exclusiveMinimum": 0 },
                  "costRate": { "type": "number", "exclusiveMinimum": 0 },
                  "currency": { "type": "string", "maxLength": 3 },
                  "priority": { "type": "integer", "minimum": 0 },
                  "rateCardId": { "type": "integer", "minimum": 1 },
                  "effectiveFrom": { "type": "string", "nullable": true },
                  "effectiveTo": { "type": "string", "nullable": true }
                }
              }
            }
          }
        }
      },
      "delete": { "operationId": "RatesController_delete" }
    },
    "/timesheets/payroll/period-summary": {
      "get": { "operationId": "PayrollController_periodSummary" }
    },
    "/timesheets/payroll/settings": {
      "get": { "operationId": "PayrollController_getSettings" },
      "patch": {
        "operationId": "PayrollController_updateSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payPeriod": { "type": "string", "enum": ["WEEKLY", "BIWEEKLY", "SEMIMONTHLY", "MONTHLY"] },
                  "overtimeDailyHours": { "type": "number" },
                  "overtimeWeeklyHours": { "type": "number" },
                  "includeNonBillable": { "type": "boolean" },
                  "payrollMapping": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/payroll/export": {
      "post": {
        "operationId": "PayrollController_exportPayroll",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["start", "end", "format"],
                "properties": {
                  "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "format": { "type": "string", "enum": ["CSV", "XLSX"] },
                  "userIds": { "type": "array", "items": { "type": "string" }, "maxItems": 500 },
                  "includeExported": { "type": "boolean" },
                  "note": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/payroll/exports": {
      "get": { "operationId": "PayrollController_listExports" }
    },
    "/timesheets/payroll/exports/{exportId}/ack": {
      "patch": {
        "operationId": "PayrollController_ackExport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["RECEIVED", "ACCEPTED", "REJECTED", "FAILED"] },
                  "note": { "type": "string", "maxLength": 1000 }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/payroll/exports/{exportId}/rows": {
      "get": { "operationId": "PayrollController_exportRows" }
    }
  }
}
