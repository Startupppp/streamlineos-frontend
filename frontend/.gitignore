# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/scripts/load-tests/results
/tests/e2e/fixtures/.auth
/tests/e2e/loading-screenshots

# next.js
/.next/
# Any custom distDir. A dev server started with `distDir: ".next-local"`
# left 718MB of Turbopack output untracked here, and the repo gates exclude the
# directory named exactly `.next`, so two of them went red over compiled chunks.
/.next-*/
/.next-baseline/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem
*.docx
*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated QR codes (local development)
/public/qr-codes/
/public/uploads/

# Plugin binary (regenerated locally)
ruvector.db

# Workflow audit artifacts
.auditui/

# Superpowers / agentic planning artifacts (local only)
docs/superpowers/

# E2E UI audit artifacts + throwaway harnesses (local only)
/e2e-artifacts/
/scripts/e2e-*.mjs


.claude-flow

.env*

# A second local dev server writes here (NEXT_DIST_DIR); never committed.
.next-local

# Build-check output from a second dist dir; never committed.
.next-build-check
# Local agent scratch (token minters, API walk harness).
.scratch

# Playwright run artifacts
/blob-report/
/playwright/.cache/
# The e2e suite's own dev-server build dir (playwright.config.ts NEXT_DIST_DIR).
.next-e2e

# minted test session token — never commit
.capture-cookie*
.build-lock
.capture-final.json
.run-build.mjs

# Local browser and Web Vitals run outputs
.browser-*-results.json
.vitals-capture-*.json

.vercel
.env*
