# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/scripts/load-tests/results
/tests/e2e/fixtures/.auth
/tests/e2e/loading-screenshots

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem
*.docx
*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated QR codes (local development)
/public/qr-codes/
/public/uploads/

# Plugin binary (regenerated locally)
ruvector.db

# Workflow audit artifacts
.auditui/

# E2E UI audit artifacts + throwaway harnesses (local only)
/e2e-artifacts/
/scripts/e2e-*.mjs
