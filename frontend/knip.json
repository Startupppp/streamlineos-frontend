{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,template,default,global-error}.{ts,tsx}",
    "app/**/{sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
    "proxy.ts",
    "instrumentation.ts",
    "next.config.ts",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "jest.config.cjs",
    "jest.setup.js",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/__tests__/**/*.{ts,tsx}",
    "feedbucket-widget/build.mjs"
  ],
  "project": ["**/*.{ts,tsx,mjs,cjs}"],
  "ignore": [".next/**", "public/**", "next-env.d.ts", "feedbucket-widget/dist/**"],
  "ignoreExportsUsedInFile": true
}
