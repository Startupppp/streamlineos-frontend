# ═══════════════════════════════════════════════════════════════
# STREAMLINEOS — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ─── Core (required) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/streamlineos
# Dedicated database for the public blog (/blogs). Optional — if unset the blog
# falls back to DATABASE_URL. Point this at a separate Postgres DB to isolate
# blog content, then run: pnpm exec tsx --env-file=.env scripts/migrate-blog.ts && pnpm seed:blog
BLOGS_DB=postgresql://user:password@localhost:5432/streamlineos_blog
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-48
NEXTAUTH_URL=http://localhost:1000
NEXT_PUBLIC_APP_URL=http://localhost:1000

# ─── Outbound Email ─────────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=support@streamlineos.in
EMAIL_FROM_NAME=StreamlineOS
EMAIL_PROVIDER=sendgrid
# Comma-separated list of recipients for contact-form notifications.
ADMIN_NOTIFICATION_EMAILS=
ADMIN_NOTIFICATION_EMAIL=
OWNER_EMAIL=

# ─── Platform Owner Seed (scripts/seed-platform-owner.ts only) ─
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=

# ─── Razorpay ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Google OAuth + SEO ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=
GOOGLE_SITE_VERIFICATION=

# ─── AI (optional) ──────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Cloudflare R2 Storage ──────────────────────────────────────
# Run `pnpm setup:r2` after filling these in.
R2_ACCOUNT_ID=
R2_REGION=auto
R2_BUCKET_NAME=streamlineos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Upstash Redis (rate limiting — required in prod) ───────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron / Webhook secrets ─────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=
WEBHOOK_SECRET=
# Local/staging load tests only (k6 sends X-Load-Test-Secret). Ignored in production.
LOAD_TEST_SECRET=

# ─── Web Push (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Ably (realtime chat / presence) ────────────────────────────
ABLY_API_KEY=

# ─── Cloudflare Turnstile (landing-form captcha) ────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Analytics (production only; scripts no-op in dev) ──────────
# Google Tag Manager — hosts GA4 + every other marketing pixel.
# Console: tagmanager.google.com  (GTM-XXXXXXXX)
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID — configure inside GTM, kept here for reference only.
# Console: analytics.google.com  (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity: clarity.microsoft.com  (10-char project ID)
NEXT_PUBLIC_CLARITY_ID=

# ─── Misc / Ops Flags ───────────────────────────────────────────
# AES-256 key for column-level encryption (openssl rand -hex 32)
ENCRYPTION_KEY=
# Set to "1" to disable HSTS header
DISABLE_HSTS=
