# ═══════════════════════════════════════════════════════════════
# STREAMLINEOS — Frontend Environment Variables
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ─── Core (required) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/streamlineos
# Optional separate DB for the public blog. Falls back to DATABASE_URL.
BLOGS_DB=

NEXTAUTH_SECRET=generate-with-openssl-rand-base64-48
NEXTAUTH_URL=http://localhost:1000
NEXT_PUBLIC_APP_URL=http://localhost:1000

# ─── Backend API ────────────────────────────────────────────────
# URL of the NestJS backend (streamlineos-api). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:1500
# Shared HS256 secret for minting short-lived JWTs to the backend.
# Must match BACKEND_JWT_SECRET in the backend .env. Generate: openssl rand -base64 48
BACKEND_JWT_SECRET=

# ─── Outbound Email ─────────────────────────────────────────────
# Option A — Resend (preferred): https://resend.com
RESEND_API_KEY=
# Option B — SendGrid: https://app.sendgrid.com
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=support@example.com
EMAIL_FROM_NAME=StreamlineOS
EMAIL_PROVIDER=sendgrid
# Comma-separated list of admin notification recipients.
ADMIN_NOTIFICATION_EMAILS=
ADMIN_NOTIFICATION_EMAIL=
OWNER_EMAIL=

# ─── Platform Owner Seed (scripts/seed-platform-owner.ts only) ─
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=

# ─── Razorpay (payments) ────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Google OAuth ────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=1
GOOGLE_SITE_VERIFICATION=

# ─── Microsoft OAuth ─────────────────────────────────────────────
# Azure portal: https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NEXT_PUBLIC_MICROSOFT_ENABLED=

# ─── AI (optional) ──────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Cloudflare R2 Storage ──────────────────────────────────────
# Console: https://dash.cloudflare.com → R2. Run: pnpm setup:r2
R2_ACCOUNT_ID=
R2_REGION=auto
R2_BUCKET_NAME=streamlineos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Upstash Redis (rate limiting — required in prod) ───────────
# Console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron / Webhook secrets ─────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=
WEBHOOK_SECRET=
# Load-test bypass secret (staging only — ignored in production).
LOAD_TEST_SECRET=

# ─── Web Push (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Ably (realtime chat / presence) ────────────────────────────
# Dashboard: https://ably.com/dashboard
ABLY_API_KEY=

# ─── Cloudflare Turnstile (landing-form captcha) ────────────────
# Dashboard: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Analytics (production only) ────────────────────────────────
# Google Tag Manager (GTM-XXXXXXXX): https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID — configure inside GTM (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity (10-char ID): https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ─── Misc / Ops ─────────────────────────────────────────────────
# AES-256 key for column-level encryption: openssl rand -hex 32
ENCRYPTION_KEY=
# Set to "1" to disable HSTS header (debugging only)
DISABLE_HSTS=0
