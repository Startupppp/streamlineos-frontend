# Full contract. .env = local dev (only what you set); .env.production.local = prod values for `next build`.
# >=44 chars, enforced at production build. Generate: openssl rand -base64 48
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:1000
# Public API origin, no trailing slash. Prod: https://api.streamlineos.in (never *.up.railway.app).
NEXT_PUBLIC_API_URL=http://localhost:1500
# Server-only origin if Cloudflare challenges Vercel egress.
# API_INTERNAL_URL=https://streamlineos-backend-production.up.railway.app
# >=44 chars, identical to backend BACKEND_JWT_SECRET.
BACKEND_JWT_SECRET=
# >=32 chars, identical to backend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# SEO/OG domain override, no protocol (default in lib/branding.ts).
NEXT_PUBLIC_BRAND_DOMAIN=www.streamlineos.in
# Single customer-facing email for all inquiries.
NEXT_PUBLIC_SUPPORT_EMAIL=support@streamlineos.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=1
NEXT_PUBLIC_MICROSOFT_ENABLED=
# Pairs with backend TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Tag Manager (GTM-XXXXXXXX): https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity (10-char ID): https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=
# "1" disables HSTS (debugging only).
DISABLE_HSTS=
# Optional TURN relay for huddle calls across strict NATs.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# QA scripts (frontend/scripts/*.mjs) only.
# QA_BASE_URL=http://localhost:1000
# DEMO_EMAIL=
# DEMO_PASSWORD=
