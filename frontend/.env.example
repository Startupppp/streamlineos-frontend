# ═══════════════════════════════════════════════════════════════
# STREAMLINEOS — Frontend Environment Variables
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ─── Core (required) ────────────────────────────────────────────
# Must be >=44 chars (256-bit) — enforced at build time for production.
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-48
NEXTAUTH_URL=http://localhost:1000

# ─── Backend API ────────────────────────────────────────────────
# Public NestJS API origin (no trailing slash). Baked into the browser bundle + CSP.
# Local: http://localhost:1500
# Production (required for cellular reliability): https://api.streamlineos.in
# Do NOT point browsers at *.up.railway.app — some mobile carriers block that hostname.
NEXT_PUBLIC_API_URL=http://localhost:1500
# Optional server-only origin for Next.js → Nest (NextAuth, RSC, auth-bridge).
# Use the Railway origin ONLY if Cloudflare bot protection challenges Vercel egress
# when calling api.streamlineos.in from the server. Never expose this to the client.
# API_INTERNAL_URL=https://streamlineos-backend-production.up.railway.app
# Shared HS256 secret for minting short-lived JWTs to the backend.
# Must be >=44 chars and IDENTICAL to BACKEND_JWT_SECRET in the backend .env. Generate: openssl rand -base64 48
BACKEND_JWT_SECRET=
# Shared secret for server-to-server auth-bridge calls.
# Must be >=32 chars and IDENTICAL to INTERNAL_API_SECRET in the backend .env.
INTERNAL_API_SECRET=

# ─── Google OAuth (NextAuth) ────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=1
GOOGLE_SITE_VERIFICATION=

# ─── Microsoft sign-in (UI flag only — no provider configured) ──
NEXT_PUBLIC_MICROSOFT_ENABLED=

# ─── Cloudflare Turnstile (site key only — secret in backend) ───
# Dashboard: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Analytics (production only) ────────────────────────────────
# Google Tag Manager (GTM-XXXXXXXX): https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity (10-char ID): https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ─── Platform Admin ─────────────────────────────────────────────
# Comma-separated emails granted platform-admin access on sign-in.
PLATFORM_ADMIN_EMAILS=

# ─── Misc / Ops ─────────────────────────────────────────────────
# Set to "1" to disable HSTS header (debugging only)
DISABLE_HSTS=0

# ─── Huddle WebRTC TURN relay (optional, improves cross-network reliability) ───
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
