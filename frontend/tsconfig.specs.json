{
  // The specs, typechecked.
  //
  // `tsconfig.json` excludes every test path, and jest transforms with SWC,
  // which strips types without checking them. So nothing in this repo has ever
  // typechecked a single test file: a fixture may describe a shape the code
  // cannot produce, a predicate may narrow to a type its input can never be,
  // and the suite still reports green. Run for the first time on 2026-09-10
  // this found fifteen errors across nine files, one of them an access fixture
  // holding a permission on a field `AccessResponse` does not have — so the
  // assertion that authority is not inferred from that permission was passing
  // because nothing read it.
  //
  // Separate from `tsconfig.json` because that one feeds `next build`, where a
  // spec is not part of the program. Run it beside `type-check`:
  //
  //     npx tsc --noEmit -p tsconfig.specs.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", ".next-buildmart", "e2e", "drizzle", "scripts"]
}
