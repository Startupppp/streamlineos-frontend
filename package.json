{
  "name": "streamlineos-root",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "typecheck": "node scripts/run.mjs typecheck",
    "dev:api": "pnpm -C backend start:dev",
    "dev:web": "pnpm -C frontend dev",
    "build:api": "pnpm -C backend build",
    "build:web": "pnpm -C frontend build",
    "typecheck:api": "pnpm -C backend typecheck",
    "typecheck:web": "pnpm -C frontend type-check",
    "check:build-execution-plan": "node scripts/check-build-execution-plan.mjs",
    "check:build-execution-plan:self-test": "node scripts/check-build-execution-plan.mjs --self-test",
    "check:hrms-execution-plan": "node scripts/check-hrms-execution-plan.mjs",
    "check:hrms-execution-plan:self-test": "node scripts/check-hrms-execution-plan.mjs --self-test",
    "install:all": "pnpm -C backend install && pnpm -C frontend install"
  }
}
