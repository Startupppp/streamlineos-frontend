{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/scripts/**/*.{ts,mjs}",
    "src/db/seeds/**/*.ts",
    "scripts/**/*.mjs",
    "src/db/schema/hrms-phase1-sql-managed.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.mjs",
    "!src/**/*.spec.ts",
    "!src/**/*.e2e-spec.ts",
    "!src/**/__tests__/**",
    "!src/test/**",
    "!test/**",
    "!evals/**",
    "!src/**/*.test-double.ts",
    "!src/**/*.spec-fixtures.ts",
    "!src/**/*.fixture.ts",
    "!src/**/*-fixtures.ts",
    "!src/**/testing/**"
  ],
  "paths": {
    "test/*": [
      "./test/*"
    ],
    "src/*": [
      "./src/*"
    ]
  },
  "ignore": [
    "src/modules/rbac/permissions/**"
  ],
  "ignoreDependencies": [
    "multer",
    "@types/multer"
  ],
  "ignoreExportsUsedInFile": true,
  "jest": false
}