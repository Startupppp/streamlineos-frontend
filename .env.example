# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/vaivamm_crm

# Auth (required)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Email — SendGrid
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Vaivamm Capital

# Email — SMTP (alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vaivamm Capital

# AI assistant (POST /api/chat — Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Team chat — Ably realtime (optional; ~30s poll fallback if unset)
ABLY_API_KEY=

# Cloudflare R2 — uploads (chat attachments, avatars, etc.)
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Security
CRON_SECRET=
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Google OAuth (Calendar / Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (Upstash) — session cache, rate limits, feature flags (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — background jobs (event + signing key from Inngest dashboard)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@vaivamm.com

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QR_REDIRECT_BASE_URL=
