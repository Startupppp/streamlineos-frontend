# ═══════════════════════════════════════════════════════════════
# VAIVAMM CAPITAL CRM — Environment Variables
# Copy this file to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ─── Database (required) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vaivamm_crm

# ─── Auth (required) ────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Security ───────────────────────────────────────────────────
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
CRON_SECRET=
WEBHOOK_SECRET=

# ─── Email — SendGrid (preferred) ───────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Vaivamm Capital
EMAIL_PROVIDER=sendgrid

# ─── Email — SMTP (alternative) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vaivamm Capital

# ─── AI / LLM ───────────────────────────────────────────────────
# Gemini (AI chat assistant)
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI (lead scoring, email generation, smart features — GPT-4o-mini)
OPENAI_API_KEY=

# ─── Google OAuth (Calendar / Meet integration) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudflare R2 — file uploads (chat, avatars, documents) ────
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Redis (Upstash) — session cache, rate limits (optional) ────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Inngest — background jobs (optional) ──────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Team chat — Ably realtime (optional; polls if unset) ──────
ABLY_API_KEY=

# ─── Web Push (VAPID) ───────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must match
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@vaivamm.com

# ─── Integrations (optional) ────────────────────────────────────
BIOMETRIC_API_KEY=
SLACK_WEBHOOK_URL=

# ─── App URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QR_REDIRECT_BASE_URL=

# ─── Test / Dev helpers ─────────────────────────────────────────
ALLOW_TEST_EMAIL=
TEST_EMAIL=

# ─── Seed data (for pnpm db:seed) ───────────────────────────────
SEED_ADMIN_EMAIL=admin@vaivamm.demo
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_HR_EMAIL=hr@vaivamm.demo
SEED_HR_PASSWORD=ChangeMe@123
OWNER_EMAIL=
ALLOW_CLEAR_REMOTE_DB=
